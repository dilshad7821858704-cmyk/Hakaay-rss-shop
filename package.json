#### 2. `server.js`
```javascript
require('dotenv').config();
const express = require('express');
const app = express();

app.use(express.json());
app.use(express.static('public'));

const API_BASE = 'https://oldcat.tech/api/seller/v1';
const headers = {
  'X-API-Key': process.env.API_KEY,
  'Content-Type': 'application/json'
};

app.get('/api/me', async (req, res) => {
  try {
    const r = await fetch(`${API_BASE}/me`, { headers });
    const data = await r.json();
    res.json(data);
  } catch (err) {
    res.status(500).json({ ok: false, error: 'Could not load profile' });
  }
});

app.post('/api/redeem', async (req, res) => {
  try {
    const { voucher_code, player_name, kingdom, x, y } = req.body;
    const r = await fetch(`${API_BASE}/redeem`, {
      method: 'POST',
      headers,
      body: JSON.stringify({
        voucher_code,
        player_name,
        kingdom: Number(kingdom),
        x: Number(x),
        y: Number(y)
      })
    });
    const data = await r.json();
    res.json(data);
  } catch (err) {
    res.status(500).json({ ok: false, error: 'Redeem request failed' });
  }
});

app.get('/api/orders/:code', async (req, res) => {
  try {
    const r = await fetch(`${API_BASE}/orders/${encodeURIComponent(req.params.code)}`, {
      headers
    });
    const data = await r.json();
    res.json(data);
  } catch (err) {
    res.status(500).json({ ok: false, error: 'Order lookup failed' });
  }
});

app.get('/api/vouchers/:code', async (req, res) => {
  try {
    const r = await fetch(`${API_BASE}/vouchers/${encodeURIComponent(req.params.code)}`, {
      headers
    });
    const data = await r.json();
    res.json(data);
  } catch (err) {
    res.status(500).json({ ok: false, error: 'Voucher lookup failed' });
  }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`hakaay rss running on port ${PORT}`));
```[span_7](start_span)[span_7](end_span)

#### 3. `public/index.html`
Type `public/index.html` as the file path and paste:
```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>hakaay rss</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #0d1117;
      color: #e6edf3;
      max-width: 540px;
      margin: 30px auto;
      padding: 16px;
    }
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 12px;
      margin-bottom: 20px;
      border-bottom: 1px solid #30363d;
    }
    .badge {
      background: #d29922;
      color: #0d1117;
      padding: 6px 12px;
      border-radius: 6px;
      font-weight: bold;
    }
    .box {
      background: #161b22;
      border: 1px solid #30363d;
      border-radius: 8px;
      padding: 16px;
      margin-bottom: 18px;
    }
    input, button {
      width: 100%;
      padding: 10px;
      margin-top: 8px;
      border-radius: 6px;
      border: 1px solid #30363d;
      box-sizing: border-box;
      font-size: 14px;
    }
    input {
      background: #0d1117;
      color: #e6edf3;
    }
    button {
      background: #d29922;
      color: #0d1117;
      font-weight: bold;
      border: none;
      cursor: pointer;
    }
    .coords {
      display: flex;
      gap: 8px;
    }
    pre {
      background: #0d1117;
      padding: 10px;
      border-radius: 6px;
      overflow-x: auto;
      font-size: 12px;
    }
  </style>
</head>
<body>
  <div class="top-bar">
    <h2>hakaay rss</h2>
    <div class="badge" id="sellerBadge">hakaay rss</div>
  </div>

  <div class="box">
    <h3>Redeem Voucher</h3>
    <input type="text" id="voucher_code" placeholder="Voucher Code (LM-XXXX-XXXX)" />
    <input type="text" id="player_name" placeholder="Player Name" />
    <div class="coords">
      <input type="number" id="kingdom" placeholder="Kingdom" />
      <input type="number" id="x" placeholder="X" />
      <input type="number" id="y" placeholder="Y" />
    </div>
    <button onclick="redeem()">Redeem Voucher</button>
    <pre id="redeemOut">Ready.</pre>
  </div>

  <div class="box">
    <h3>Check Order Status</h3>
    <input type="text" id="order_code" placeholder="Order Code" />
    <button onclick="checkOrder()">Check Order</button>
    <pre id="orderOut">Enter an order code to check.</pre>
  </div>

  <div class="box">
    <h3>Check Voucher Status</h3>
    <input type="text" id="check_voucher_code" placeholder="Voucher Code (LM-XXXX-XXXX)" />
    <button onclick="checkVoucher()">Check Voucher</button>
    <pre id="voucherOut">Enter a voucher code to check.</pre>
  </div>

  <script>
    async function loadProfile() {
      try {
        const res = await fetch('/api/me');
        const data = await res.json();
        const name =
          data.name ||
          data.username ||
          data.seller_name ||
          (data.user && data.user.name) ||
          (data.data && data.data.name) ||
          'hakaay rss';
        document.getElementById('sellerBadge').textContent = name;
      } catch (e) {
        document.getElementById('sellerBadge').textContent = 'hakaay rss';
      }
    }

    async function redeem() {
      const payload = {
        voucher_code: document.getElementById('voucher_code').value.trim(),
        player_name: document.getElementById('player_name').value.trim(),
        kingdom: document.getElementById('kingdom').value.trim(),
        x: document.getElementById('x').value.trim(),
        y: document.getElementById('y').value.trim()
      };
      const res = await fetch('/api/redeem', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      document.getElementById('redeemOut').textContent = JSON.stringify(data, null, 2);
      if (data.order_code) {
        document.getElementById('order_code').value = data.order_code;
      }
    }

    async function checkOrder() {
      const code = document.getElementById('order_code').value.trim();
      if (!code) return;
      const res = await fetch(`/api/orders/${encodeURIComponent(code)}`);
      const data = await res.json();
      document.getElementById('orderOut').textContent = JSON.stringify(data, null, 2);
    }

    async function checkVoucher() {
      const code = document.getElementById('check_voucher_code').value.trim();
      if (!code) return;
      const res = await fetch(`/api/vouchers/${encodeURIComponent(code)}`);
      const data = await res.json();
      document.getElementById('voucherOut').textContent = JSON.stringify(data, null, 2);
    }

    loadProfile();
  </script>
</body>
</html>
